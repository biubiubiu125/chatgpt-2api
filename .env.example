# ============================================
# ChatGPT2API 环境变量配置示例
# ============================================

# 认证密钥（必填）
CHATGPT2API_AUTH_KEY=your_secret_key_here

# Web / API 暴露端口
CHATGPT2API_PORT=2080

# 后端同步工作线程并发容量；只要求正整数，不设置人为最高值。
# 它控制同步接口入口可同时占用的线程数，不等于同时出图数，也不等于账号、代理或上游并发上限。
CHATGPT2API_THREAD_TOKENS=120

# 同时打上游的图片数，一张图占一个名额。面板任务、OpenAI 出图接口、聊天生图和超时后续查共用。
# 只要求正整数。调大线程容量不会提高这个值。
CHATGPT2API_IMAGE_TASK_WORKERS=16

# 还没打上游的图片还能排多少张。一次要 n 张就占 n 个名额。排满后，同步接口和任务接口都会立刻拒绝。只要求正整数。
CHATGPT2API_IMAGE_TASK_QUEUE_SIZE=256

# Docker 镜像
CHATGPT2API_IMAGE=ghcr.io/biubiubiu125/chatgpt-2api:latest

# 中国时区。安装脚本创建的应用和 PostgreSQL 容器都使用此时区。
TZ=Asia/Shanghai
COMPOSE_PROJECT_NAME=chatgpt-2api

# 图片访问地址（可选，用于生成对外图片查看链接；留空则按当前请求地址生成）
# 安装时只填域名或 IP，会自动保存为 https:// 地址。
# CHATGPT2API_BASE_URL=https://your-domain.com

# ============================================
# 应用数据库
# ============================================

# 容器启动要求 PostgreSQL。DATABASE_URL 为空时不会再回退 SQLite。
# install.sh 会通过 docker-compose.postgres.yml 写入数据库地址。
# 本地 pytest / uv run 未设置 DATABASE_URL 时，进程仍可用 data/chatgpt2api.db。
# DATABASE_URL=

# 本地 PostgreSQL Compose overlay（docker-compose.postgres.yml）
# 密码仅使用字母、数字、下划线或连字符，避免连接 URI 编码不一致。
# POSTGRES_DB=chatgpt_2api_app
# POSTGRES_USER=chatgpt_2api
# POSTGRES_PASSWORD=replace_with_a_strong_password

# Supabase 示例
# DATABASE_URL=postgresql://postgres.xxx:password@aws-1-us-west-1.pooler.supabase.com:5432/postgres

# SQLite 示例
# DATABASE_URL=sqlite:////app/data/chatgpt2api.db
